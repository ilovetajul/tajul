# PostgreSQL — Supabase example (two different URLs, both from Project Settings > Database):

# 1) DATABASE_URL — the POOLED connection (Transaction pooler, port 6543).
#    Used by the live app at runtime. MUST include ?pgbouncer=true&connection_limit=1
#    or serverless functions (Netlify/Vercel) will fail to connect.
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2) DIRECT_URL — the DIRECT connection (port 5432, no pooler).
#    Used only when running `npx prisma migrate` locally. Do NOT use this one in Netlify.
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@xxxxx.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage (Project Settings > API in your Supabase dashboard)
# SUPABASE_URL is the same project URL as your database, e.g. https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is SECRET — server-only, never prefix with NEXT_PUBLIC_,
# never commit it, never send it to the browser. It's what lets uploads/deletes work.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Seed script creates this admin account on first run
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_NAME="Tajul Islam"
